{
  "name": "daybook-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Daybook web UI — one bundle serving both the Tauri shell and the browser PWA.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "dev": "npm run build:wasm && vite --port 1420 --strictPort",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tauri-apps/api": "2.11.1",
    "alpinejs": "3.15.12",
    "basecoat-css": "1.0.2",
    "codemirror": "6.0.2",
    "y-codemirror.next": "0.3.5",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/alpinejs": "3.13.11",
    "playwright": "1.58.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
